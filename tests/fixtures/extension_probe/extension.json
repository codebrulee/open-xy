{
  "id": "probe",
  "name": "Probe",
  "description": "SDK test extension: records the events it receives, writes notes when Record is released, and reads and writes the arrangement.",
  "claims": [
    "record_double_tap",
    "performance_play",
    "performance_stop",
    "performance_undo",
    "performance_arm"
  ],
  "actions": [
    "edit_notes",
    "notify",
    "read_arrangement",
    "write_arrangement",
    "undo_arrangement",
    "stop_song",
    "disarm_record",
    "hold_song_end",
    "read_pattern",
    "play_song"
  ]
}
