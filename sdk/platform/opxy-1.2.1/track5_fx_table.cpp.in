extern "C" {
@DECLARATIONS@
}

const opxy::platform::Fx3Effect sdk_fx3_effects[] = {
@EFFECTS@
};
const opxy::u32 sdk_fx3_effect_count = @COUNT@;
const opxy::u32 sdk_fx3_records = @EFFECT_RECORDS@;
const opxy::u32 sdk_fx3_record_bytes = @RECORD_BYTES@;
const opxy::u32 sdk_fx3_record_count = @EFFECT_LIMIT@;
const opxy::u32 sdk_fx3_buffer_limit = @BUFFER_LIMIT@;
